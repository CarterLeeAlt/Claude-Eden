{
  "name": "eden-workbench",
  "private": true,
  "version": "0.1.8-rc",
  "type": "module",
  "scripts": {
    "prepare-vnc": "node scripts/prepare-vnc.mjs",
    "prepare-ui": "node scripts/prepare-ui.mjs",
    "dev": "node scripts/prepare-ui.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-ui.mjs && tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "build-native-probe": "node scripts/build-native-probe.mjs",
    "test": "node scripts/prepare-ui.mjs && node --import tsx --test src/__tests__/*.test.mjs scripts/verify-build.test.mjs",
    "typecheck": "node scripts/prepare-ui.mjs && tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.65.0",
    "marked": "18.1.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.5"
  }
}
