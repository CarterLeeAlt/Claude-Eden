#!/usr/bin/env bash
#
# THIRD_PARTY_LICENSES: the license and notice files of every module and of Go
# itself that the release binaries are built from.
#
#   scripts/licenses            rewrite THIRD_PARTY_LICENSES
#   scripts/licenses --check    fail when it is out of date
#
# Enumerate the Windows desktop and Linux guest-agent/Tailscale entry points.
# Use the workspace Go toolchain and
# module cache; run through scripts/run-in-workspace.mjs.

set -euo pipefail
export GOTOOLCHAIN=local

ROOT="$(CDPATH= cd -P -- "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null && pwd)"
OUT="$ROOT/THIRD_PARTY_LICENSES"
cd "$ROOT"

check=""
[[ $# -le 1 ]] || { echo 'Usage: bash scripts/licenses [--check]' >&2; exit 2; }
case "${1:-}" in
  "") ;;
  --check) check=1 ;;
  *) echo 'Usage: bash scripts/licenses [--check]' >&2; exit 2 ;;
esac

windows_tags="$(awk -F "'" '$1 ~ /^[[:space:]]*[$]tags = / { print $2 }' scripts/build-windows.ps1)"
[ -n "$windows_tags" ] || { echo 'licenses: no tags in scripts/build-windows.ps1' >&2; exit 1; }

host_os="$(go env GOHOSTOS)"
workspace_root="$ROOT"
if [[ "$host_os" == windows ]]; then workspace_root="$(cygpath -m "$ROOT")"; fi
workspace_directory() {
  local directory="$1"
  if [[ "$host_os" == windows ]]; then directory="$(cygpath -u "$directory")"; fi
  directory="$(cd "$directory" && pwd -P)"
  # Git Bash mounts the inherited TMP directory at /tmp, so one workspace can
  # have both /d/... and /tmp aliases. Compare their absolute Windows paths.
  if [[ "$host_os" == windows ]]; then directory="$(cygpath -m "$directory")"; fi
  case "$directory" in
    "$workspace_root"|"$workspace_root"/*) printf '%s\n' "$directory" ;;
    *) echo "licenses: toolchain and dependency sources must be inside the workspace: $directory" >&2; return 1 ;;
  esac
}
workspace_directory "$(dirname "$(command -v go)")" >/dev/null
go_root="$(workspace_directory "$(go env GOROOT)")"
workspace_directory "$(go env GOMODCACHE)" >/dev/null

# Different entry modules can select different versions; retain both license
# records instead of deduplicating by module path alone.
modules() ( # <module-directory> <goos> <goarch> <cgo> <tags> <package>
  cd "$ROOT/$1"
  echo "licenses: $1 $2/$3 $6" >&2
  GOOS="$2" GOARCH="$3" CGO_ENABLED="$4" GOWORK=off GOFLAGS= go list -mod=readonly -deps -tags "$5" \
    -f '{{with .Module}}{{if not .Main}}{{.Path}}{{"\t"}}{{if .Replace}}{{if .Replace.Version}}{{.Replace.Version}}{{else}}(local){{end}}{{else}}{{if .Version}}{{.Version}}{{else}}(local){{end}}{{end}}{{"\t"}}{{.Dir}}{{end}}{{end}}' "$6"
)

list="$(mktemp)"
trap 'rm -f "$list"' EXIT
{
  modules . windows amd64 0 "$windows_tags" ./cmd/eden
  for arch in amd64 arm64; do
    modules . linux "$arch" 0 '' github.com/lima-vm/lima/v2/cmd/lima-guestagent
    modules tools/tailnet linux "$arch" 0 '' .
  done
} | tr -d '\r' | awk -F '\t' 'NF == 3 && !seen[$1 FS $2]++' | LC_ALL=C sort > "$list"

[ -s "$list" ] || { echo "licenses: go list found no module" >&2; exit 1; }

render() {
  cat <<'EOF'
Third-party licenses

Claude Eden is MIT licensed (LICENSE), with upstream notices in NOTICE.
Its Windows desktop, Linux guest agent and guest Tailscale component
use the modules below and Go's standard library. Each section gives a
module, its version and the license and notice files at its source root, verbatim.
third_party/ holds the bundled Lima, sshocker, pkg/sftp and gvisor-tap-vsock
source compiled into Claude Eden (see NOTICE).

Generated by scripts/licenses.

EOF
  printf '================================================================================\n'
  printf 'gaoyifan/china-operator-ip: mainland exit address list (MIT)\n'
  printf '================================================================================\n\n'
  cat internal/exitpolicy/data/LICENSE
  printf '\n'
  printf '================================================================================\n'
  printf 'Go standard library (BSD-3-Clause)\n'
  printf '================================================================================\n\n'
  cat "$go_root/LICENSE"
  printf '\n'
  while IFS=$'\t' read -r path version dir; do
    dir="$(workspace_directory "$dir")"
    found=0
    # LICENSE, LICENCE, COPYING, NOTICE, UNLICENSE, PATENTS, with any suffix.
    while IFS= read -r f; do
      found=1
      printf '================================================================================\n'
      printf '%s %s: %s\n' "$path" "${version:-}" "$(basename "$f")"
      printf '================================================================================\n\n'
      cat "$f"
      printf '\n'
    done < <(find "$dir" -maxdepth 1 -type f \( -iname 'licen[sc]e*' -o -iname 'copying*' -o -iname 'notice*' -o -iname 'unlicense*' -o -iname 'patents*' \) | LC_ALL=C sort)
    if [ "$found" = 0 ]; then
      echo "licenses: no license file in $path $version ($dir)" >&2
      return 1
    fi
  done < "$list"
  tailnet_version="$(awk '$1 == "tailscale.com" { sub(/^v/, "", $2); print $2 }' tools/tailnet/go.mod)"
  cat <<EOF

Workbench guest Tailscale component
----------------------------------
Tailscale $tailnet_version (https://github.com/tailscale/tailscale), BSD-3-Clause.
The guest-only executable also uses gliderlabs/ssh (BSD-3-Clause), pkg/sftp
(BSD-2-Clause), creack/pty (MIT), and the
transitive modules pinned in tools/tailnet/go.mod and tools/tailnet/go.sum.
Full license notices for the Linux amd64/arm64 payloads are included above
and distributed in the application licenses/tailnet-go directory.
EOF
}

tmp="$(mktemp)"
trap 'rm -f "$list" "$tmp"' EXIT
render > "$tmp"

if [ -n "$check" ]; then
  if cmp -s "$tmp" "$OUT"; then
    echo "THIRD_PARTY_LICENSES is up to date"
  else
    echo "THIRD_PARTY_LICENSES is out of date: run scripts/licenses" >&2
    diff "$OUT" "$tmp" | head -20 >&2 || true
    exit 1
  fi
else
  chmod 0644 "$tmp"
  mv "$tmp" "$OUT"
  echo "THIRD_PARTY_LICENSES: $(wc -l < "$list" | tr -d ' ') modules"
fi
