diff --git a/pkg/limatype/filenames/ssh_socket_windows.go b/pkg/limatype/filenames/ssh_socket_windows.go
new file mode 100644
--- /dev/null
+++ b/pkg/limatype/filenames/ssh_socket_windows.go
@@ -0,0 +1,8 @@
+// SPDX-FileCopyrightText: Copyright The Lima Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package filenames
+
+// OpenSSH adds a 17-byte temporary suffix; reserve it without consuming an
+// unnecessary seven bytes of the Windows AF_UNIX path budget.
+const SSHSock = "s"
