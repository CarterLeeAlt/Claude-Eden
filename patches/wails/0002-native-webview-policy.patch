diff --git a/pkg/application/webview_policy.go b/pkg/application/webview_policy.go
new file mode 100644
index 0000000..4f24c69
--- /dev/null
+++ b/pkg/application/webview_policy.go
@@ -0,0 +1,44 @@
+package application
+
+// WindowsWebViewPolicy supplies native WebView2 policy decisions. Policies are
+// installed before the first navigation and reapplied to replacement controllers.
+// Navigation/new-window/download callbacks run on the UI thread and must return
+// promptly. ScriptDialog runs off the UI thread with a native deferral held.
+type WindowsWebViewPolicy struct {
+	// DocumentStartScript is registered before navigation and on replacement
+	// controllers. Initialized runs only after its registration has completed.
+	DocumentStartScript  string
+	AllowNavigation      func(WebViewNavigation) bool
+	BlockNewWindow       func(string) bool
+	CancelDownload       func(string) bool
+	ScriptDialog         func(WebViewScriptDialog) (WebViewScriptDialogResult, error)
+	Initialized          func(recovering bool) error
+	InitializationFailed func(error)
+	NavigationCompleted  func(WebViewNavigationResult)
+	ProcessFailed        func(WebViewProcessFailure)
+}
+
+type WebViewNavigation struct {
+	URL           string
+	UserInitiated bool
+	Redirected    bool
+}
+type WebViewNavigationResult struct {
+	URL            string
+	Success        bool
+	WebErrorStatus uint32
+}
+type WebViewProcessFailure struct {
+	Kind              uint32
+	RecoveryAvailable bool
+}
+type WebViewScriptDialog struct {
+	URL         string
+	Kind        uint32
+	Message     string
+	DefaultText string
+}
+type WebViewScriptDialogResult struct {
+	Accept bool
+	Text   string
+}
diff --git a/pkg/application/webview_policy_windows.go b/pkg/application/webview_policy_windows.go
new file mode 100644
index 0000000..2be464b
--- /dev/null
+++ b/pkg/application/webview_policy_windows.go
@@ -0,0 +1,396 @@
+//go:build windows && !server
+
+package application
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"unsafe"
+
+	"github.com/wailsapp/wails/v3/internal/webview2/pkg/combridge"
+	"github.com/wailsapp/wails/v3/internal/webview2/pkg/webview2"
+)
+
+type policyDocumentScriptRegistrar interface {
+	CallDevTools(string, string, func(string, error)) error
+}
+
+func registerPolicyDocumentStartScript(chromium policyDocumentScriptRegistrar, script string, done func(error)) {
+	if script == "" {
+		done(nil)
+		return
+	}
+	params, err := json.Marshal(map[string]string{"source": script})
+	if err != nil {
+		done(err)
+		return
+	}
+	if err := chromium.CallDevTools("Page.addScriptToEvaluateOnNewDocument", string(params), func(result string, err error) {
+		if err == nil {
+			var value struct{ Identifier string }
+			err = json.Unmarshal([]byte(result), &value)
+			if err == nil && value.Identifier == "" {
+				err = errors.New("webview2: document-start script registration returned no identifier")
+			}
+		}
+		done(err)
+	}); err != nil {
+		done(err)
+	}
+}
