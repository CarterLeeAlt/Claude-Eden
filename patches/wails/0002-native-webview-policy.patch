+func windowsDialogDefaultExtension(filters []FileFilter) string {
+	if len(filters) == 0 {
+		return ""
+	}
+	pattern := strings.TrimSpace(strings.Split(filters[0].Pattern, ";")[0])
+	if !strings.HasPrefix(pattern, "*.") {
+		return ""
+	}
+	extension := strings.TrimPrefix(pattern, "*.")
